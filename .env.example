# Environment configuration for development
# Copy this to .env and fill in your actual Cognito values

# AWS Cognito Configuration (REQUIRED)
COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
COGNITO_APP_CLIENT_ID=your-app-client-id-here
COGNITO_CLIENT_SECRET=your-app-client-secret-if-applicable
COGNITO_DOMAIN=your-app-domain.auth.us-east-1.amazoncognito.com
COGNITO_REDIRECT_URI=http://localhost:8000/api/v1/auth/callback

# Optional Configuration
JWKS_CACHE_TTL=300
LOG_LEVEL=INFO
TESTING_MODE=false
